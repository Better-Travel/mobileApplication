CREATE TABLE BookmarkedPlace (
    id TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    routeTitle TEXT NOT NULL,
    latitude REAL NOT NULL,
    longitude REAL NOT NULL,
    savedAtMillis INTEGER NOT NULL
);

selectAll:
SELECT * FROM BookmarkedPlace ORDER BY savedAtMillis DESC;

insertOrReplace:
INSERT OR REPLACE INTO BookmarkedPlace(id, name, routeTitle, latitude, longitude, savedAtMillis)
VALUES (?, ?, ?, ?, ?, ?);

deleteById:
DELETE FROM BookmarkedPlace WHERE id = ?;
